---
import '../styles/global.css';
import { brand, contact, offers } from '../data/site';

interface Props {
  title?: string;
  description?: string;
  includeStructuredData?: boolean;
  additionalStructuredData?: Record<string, unknown> | null;
}

const {
  title = 'Nepomka — автомобильный специалист в Белгороде',
  description = brand.description,
  includeStructuredData = true,
  additionalStructuredData = null,
} = Astro.props;

const base = import.meta.env.BASE_URL;
const canonical = new URL(Astro.url.pathname, Astro.site);
const ogImage = new URL(`${base}branding/og-cover.png`, Astro.site);
const personJsonLd = {
  '@context': 'https://schema.org',
  '@type': 'Person',
  name: brand.person,
  alternateName: brand.name,
  jobTitle: brand.descriptor,
  description,
  image: ogImage.href,
  url: new URL(base, Astro.site).href,
  telephone: contact.phone,
  sameAs: [contact.telegram, contact.instagram],
  areaServed: {
    '@type': 'City',
    name: 'Белгород',
  },
  makesOffer: offers.map((offer) => ({
    '@type': 'Offer',
    ...(offer.price.startsWith('от ')
      ? {}
      : { price: offer.priceValue, priceCurrency: 'RUB' }),
    description: `${offer.price}. ${offer.prepare}`,
    itemOffered: {
      '@type': 'Service',
      name: offer.title,
      areaServed:
        offer.mode === 'ОНЛАЙН'
          ? 'Россия, онлайн'
          : 'Белгород и ближайшая география по договорённости',
    },
  })),
};
---

<!doctype html>
<html lang="ru">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="color-scheme" content="light" />
    <meta name="theme-color" content="#f1f0eb" />
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    <link rel="icon" type="image/png" href={`${base}branding/nepomka-favicon.png`} />
    <link rel="apple-touch-icon" href={`${base}branding/nepomka-apple-touch-icon.png`} />
    <link rel="manifest" href={`${base}site.webmanifest`} />
    <meta property="og:type" content="website" />
    <meta property="og:locale" content="ru_RU" />
    <meta property="og:site_name" content={brand.name} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={ogImage} />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImage} />
    <title>{title}</title>
    {
      includeStructuredData && (
        <script type="application/ld+json" is:inline set:html={JSON.stringify(personJsonLd)} />
      )
    }
    {
      additionalStructuredData && (
        <script
          type="application/ld+json"
          is:inline
          set:html={JSON.stringify(additionalStructuredData)}
        />
      )
    }
  </head>
  <body>
    <a class="skip-link" href="#main">Перейти к содержанию</a>
    <slot />
    <script>
      import '../scripts/site.ts';
    </script>
  </body>
</html>
