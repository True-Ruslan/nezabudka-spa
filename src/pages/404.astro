---
import BrandMark from '../components/BrandMark.astro';
import BaseLayout from '../layouts/BaseLayout.astro';

const base = import.meta.env.BASE_URL;
---

<BaseLayout
  title="Страница не найдена — NEZABUDKA"
  description="Запрошенная страница не существует. Вернитесь на главную страницу NEZABUDKA."
>
  <main id="main" class="section section--paper error-page">
    <div class="shell">
      <a class="error-page__brand" href={base} aria-label="NEZABUDKA — на главную">
        <BrandMark compact={true} />
      </a>

      <div class="section-heading error-page__heading">
        <p class="section-heading__label">404 / NOT FOUND</p>
        <div class="section-heading__grid error-page__heading-grid">
          <h1>Страница не найдена.</h1>
          <p>
            Адрес мог измениться или такой страницы здесь никогда не было.
          </p>
        </div>
      </div>

      <div class="error-page__actions">
        <a class="button" href={base}>На главную</a>
        <a class="button button--ghost" href={`${base}#contact`}>К контакту</a>
      </div>
    </div>
  </main>
</BaseLayout>

<style>
  .error-page {
    min-height: 100vh;
  }

  .error-page__brand {
    display: inline-flex;
  }

  .error-page__brand:focus-visible {
    outline: 2px solid var(--blue);
    outline-offset: 5px;
  }

  .error-page__heading {
    max-width: 900px;
    margin-top: clamp(5rem, 14vw, 11rem);
  }

  .error-page__heading-grid {
    grid-template-columns: 1fr;
  }

  .error-page__heading h1 {
    margin: 0;
    font-size: clamp(3.5rem, 9vw, 8rem);
    font-weight: 500;
    letter-spacing: -0.055em;
    line-height: 0.92;
  }

  .error-page__heading-grid > p {
    max-width: 620px;
    margin-top: 2rem;
  }

  .error-page__actions {
    display: flex;
    flex-wrap: wrap;
    gap: 12px;
    padding-bottom: clamp(5rem, 14vw, 11rem);
  }
</style>
