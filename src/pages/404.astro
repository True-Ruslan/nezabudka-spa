---
import BrandMark from '../components/BrandMark.astro';
import BaseLayout from '../layouts/BaseLayout.astro';

const base = import.meta.env.BASE_URL;
---

<BaseLayout
  title="Страница не найдена — NEZABUDKA"
  description="Запрошенная страница не существует. Вернитесь на главную страницу NEZABUDKA."
>
  <main id="main" class="section section--paper">
    <div class="shell">
      <a href={base} aria-label="NEZABUDKA — на главную">
        <BrandMark compact={true} />
      </a>

      <div class="section-heading" style="margin-top: clamp(5rem, 14vw, 11rem); max-width: 900px;">
        <p class="section-heading__label">404 / NOT FOUND</p>
        <div class="section-heading__grid" style="grid-template-columns: 1fr;">
          <h1 style="margin: 0; font-size: clamp(3.5rem, 9vw, 8rem); font-weight: 500; letter-spacing: -0.055em; line-height: 0.92;">
            Страница не найдена.
          </h1>
          <p style="max-width: 620px; margin-top: 2rem;">
            Адрес мог измениться или такой страницы здесь никогда не было.
          </p>
        </div>
      </div>

      <div style="display: flex; flex-wrap: wrap; gap: 12px; padding-bottom: clamp(5rem, 14vw, 11rem);">
        <a class="button" href={base}>На главную</a>
        <a class="button button--ghost" href={`${base}#contact`}>К контакту</a>
      </div>
    </div>
  </main>
</BaseLayout>
