---
import Contact from '../../components/Contact.astro';
import Footer from '../../components/Footer.astro';
import Header from '../../components/Header.astro';
import ServiceDetail from '../../components/ServiceDetail.astro';
import { paintProtectionFilmPage as config } from '../../data/service-pages';
import { offers } from '../../data/site';
import BaseLayout from '../../layouts/BaseLayout.astro';
import { buildServiceStructuredData } from '../../lib/service-structured-data';

const offer = offers.find((candidate) => candidate.id === config.offerId);
if (!offer) throw new Error(`Missing offer for service page: ${config.offerId}`);

const structuredData = buildServiceStructuredData({
  offer,
  config,
  site: Astro.site,
  base: import.meta.env.BASE_URL,
});
---

<BaseLayout
  title={config.seoTitle}
  description={config.seoDescription}
  additionalStructuredData={structuredData}
>
  <Header />
  <main id="main">
    <ServiceDetail {offer} {config} />
    <Contact initialOfferId={offer.id} />
  </main>
  <Footer />
</BaseLayout>
