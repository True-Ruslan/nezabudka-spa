---
import ArrowIcon from './ArrowIcon.astro';
import { brand } from '../data/site';
const base = import.meta.env.BASE_URL;
---

<section class="hero" aria-labelledby="hero-title">
  <div class="shell hero__grid">
    <div class="hero__copy" data-reveal>
      <p class="eyeline">ДАНИЛ НЕПОМНЯЩИЙ / NEPOMKA</p>
      <h1 id="hero-title">Разберёмся<br />с автомобилем.<br /><span>Без догадок.</span></h1>
      <p class="hero__lead">Проверка и подбор автомобилей с пробегом, бронеплёнка, тонировка, запчасти и независимый взгляд на ремонт.</p>
      <p class="hero__location">Белгород · онлайн и очно · ближайшая география по договорённости</p>
      <div class="hero__actions">
        <a class="button" href={`${base}#contact`}>Обсудить мою ситуацию <ArrowIcon direction="up-right" /></a>
        <a class="hero__secondary" href={`${base}#expertise`}>С чем могу помочь</a>
      </div>
      <p class="hero__caption">Напишите марку, модель и задачу — рассчитаю стоимость до начала работы.</p>
    </div>
    <div class="hero__visual" data-reveal>
      <img
        class="hero__portrait"
        data-hero-portrait
        src={`${base}branding/danil-hero.webp`}
        width="1122"
        height="1402"
        alt={brand.person}
        loading="eager"
        decoding="async"
        fetchpriority="high"
      />
    </div>
  </div>
</section>

<style>
  .hero h1 {
    max-width: 690px;
    margin-bottom: 22px;
    font-size: clamp(46px, 5vw, 72px);
    font-weight: 500;
    letter-spacing: -0.05em;
    line-height: 0.96;
  }

  .hero__statement {
    max-width: 600px;
    margin-bottom: 18px;
    color: var(--ink);
    font-size: clamp(27px, 2.7vw, 42px);
    font-weight: 500;
    letter-spacing: -0.035em;
    line-height: 1.02;
  }

  .hero__lead {
    margin-bottom: 32px;
  }

  .hero__visual {
    position: relative;
    min-height: 560px;
    height: clamp(600px, 78vh, 760px);
    overflow: hidden;
    border-left: 1px solid var(--line);
    background: #10171d;
  }

  .hero__portrait {
    display: block;
    width: 100%;
    height: 100%;
    min-height: 560px;
    object-fit: cover;
    object-position: center 16%;
  }

  @media (max-width: 760px) {
    .hero h1 {
      margin-bottom: 20px;
      font-size: clamp(37px, 10.4vw, 52px);
      line-height: 0.98;
    }

    .hero__statement {
      font-size: clamp(28px, 8vw, 38px);
    }

    .hero__visual {
      min-height: 0;
      height: 390px;
      border-top: 1px solid var(--line);
      border-left: 0;
    }

    .hero__portrait {
      min-height: 0;
      height: 390px;
    }
  }
</style>
