---
import { brand } from '../data/site';
const base = import.meta.env.BASE_URL;
---

<section class="hero" aria-labelledby="hero-title">
  <div class="shell hero__grid">
    <div class="hero__copy" data-reveal>
      <p class="eyeline">NEPOMKA / AUTOMOTIVE</p>
      <h1 id="hero-title">{brand.person}</h1>
      <p class="hero__statement">{brand.statement}</p>
      <p class="hero__lead">{brand.description}</p>
      <div class="hero__actions">
        <a class="button" href={`${base}#contact`}>
          Обсудить автомобиль <span aria-hidden="true">→</span>
        </a>
        <a class="button button--ghost" href={`${base}#experience`}>Посмотреть опыт</a>
      </div>
      <div class="hero__domains" aria-label="Области опыта">
        <span>Состояние авто</span><span>Сервис и уход</span><span>Подбор деталей</span><span>B2B automotive</span>
      </div>
    </div>

    <div class="hero__visual" data-reveal>
      <img
        class="hero__portrait"
        data-hero-portrait
        src={`${base}branding/danil-hero.webp`}
        width="1122"
        height="1402"
        alt={brand.person}
        loading="eager"
        decoding="async"
        fetchpriority="high"
      />
    </div>
  </div>
</section>

<style>
  .hero h1 {
    max-width: 690px;
    margin-bottom: 22px;
    font-size: clamp(46px, 5.3vw, 82px);
    font-weight: 500;
    letter-spacing: -0.05em;
    line-height: 0.96;
  }

  .hero__statement {
    max-width: 600px;
    margin-bottom: 18px;
    color: var(--ink);
    font-size: clamp(27px, 2.7vw, 42px);
    font-weight: 500;
    letter-spacing: -0.035em;
    line-height: 1.02;
  }

  .hero__lead {
    margin-bottom: 32px;
  }

  .hero__visual {
    position: relative;
    min-height: 620px;
    overflow: hidden;
    border-left: 1px solid var(--line);
    background: #10171d;
  }

  .hero__portrait {
    display: block;
    width: 100%;
    height: 100%;
    min-height: 620px;
    object-fit: cover;
    object-position: center;
  }

  @media (max-width: 760px) {
    .hero h1 {
      margin-bottom: 20px;
      font-size: clamp(44px, 13vw, 66px);
      line-height: 0.98;
    }

    .hero__statement {
      font-size: clamp(28px, 8vw, 38px);
    }

    .hero__visual {
      min-height: 470px;
      border-top: 1px solid var(--line);
      border-left: 0;
    }

    .hero__portrait {
      min-height: 470px;
    }
  }
</style>
