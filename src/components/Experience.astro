---
import SectionHeading from './SectionHeading.astro';
import { experience } from '../data/site';
---

<section class="section section--paper" id="experience" aria-labelledby="experience-title">
  <div class="shell">
    <SectionHeading
      index="03"
      label="ОПЫТ"
      title="Не одна должность, а несколько сторон отрасли."
      intro="Каждый этап добавлял новый слой: видеть состояние, разговаривать с владельцем, ориентироваться в запчастях и понимать коммерческие процессы."
    />
    <ol class="experience-list" data-reveal>
      {experience.map((item, index) => (
        <li class="experience-row">
          <span class="experience-row__index">{String(index + 1).padStart(2, '0')}</span>
          <h3>{item.title}</h3>
          <p>{item.description}</p>
        </li>
      ))}
    </ol>
  </div>
</section>
