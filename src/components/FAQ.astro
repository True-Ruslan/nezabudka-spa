---
import { questions } from '../data/site';
---
<section class="section section--soft" id="faq" aria-labelledby="faq-title">
  <div class="shell faq-grid">
    <div><p class="section-heading__label">04 / ВОПРОСЫ</p><h2 class="editorial-title" id="faq-title">До первого<br />сообщения.</h2></div>
    <div class="faq-list">{questions.map(item => <details><summary>{item.question}</summary><p>{item.answer}</p></details>)}</div>
  </div>
</section>
