---
import type { CollectionEntry } from 'astro:content';

type Props = {
  entry: CollectionEntry<'cases'>;
};

const { entry } = Astro.props;
const sections = [
  ['01 / PROBLEM', 'Задача', entry.data.problem],
  ['02 / CHECK', 'Проверка', entry.data.investigation],
  ['03 / DECISION', 'Решение', entry.data.decision],
  ['04 / WHY', 'Почему так', entry.data.rationale],
  ['05 / RESULT', 'Результат', entry.data.result],
] as const;
---

<article class="case-detail">
  <header class="case-detail__header">
    <p class="case-detail__meta">{entry.data.vehicle} / {entry.data.context}</p>
    <h1>{entry.data.title}</h1>
    <p class="case-detail__summary">{entry.data.summary}</p>
  </header>

  <div class="case-detail__sections">
    {sections.map(([label, title, value]) => (
      <section class="case-detail__section">
        <p class="case-detail__label">{label}</p>
        <div>
          <h2>{title}</h2>
          <p>{value}</p>
        </div>
      </section>
    ))}
  </div>
</article>

<style>
  .case-detail {
    padding-bottom: clamp(72px, 10vw, 144px);
  }

  .case-detail__header {
    display: grid;
    gap: 24px;
    max-width: 1080px;
    padding: clamp(48px, 8vw, 112px) 0 clamp(56px, 9vw, 120px);
  }

  .case-detail__meta,
  .case-detail__label {
    margin: 0;
    color: var(--steel);
    font-family: var(--font-mono);
    font-size: 10px;
    letter-spacing: 0.12em;
    text-transform: uppercase;
  }

  .case-detail h1 {
    max-width: 980px;
    margin: 0;
    font-size: clamp(3rem, 7vw, 7rem);
    font-weight: 500;
    letter-spacing: -0.055em;
    line-height: 0.94;
  }

  .case-detail__summary {
    max-width: 700px;
    margin: 0;
    color: var(--steel);
    font-size: clamp(1rem, 1.5vw, 1.25rem);
    line-height: 1.6;
  }

  .case-detail__sections {
    border-top: 1px solid var(--line);
  }

  .case-detail__section {
    display: grid;
    grid-template-columns: minmax(120px, 0.42fr) minmax(0, 1fr);
    gap: clamp(24px, 6vw, 96px);
    padding: clamp(32px, 5vw, 64px) 0;
    border-bottom: 1px solid var(--line);
  }

  .case-detail__section h2 {
    margin: 0 0 12px;
    font-size: clamp(1.35rem, 2.5vw, 2.3rem);
    font-weight: 500;
    letter-spacing: -0.035em;
  }

  .case-detail__section div > p {
    max-width: 760px;
    margin: 0;
    color: var(--steel);
    font-size: 1rem;
    line-height: 1.7;
  }

  @media (max-width: 720px) {
    .case-detail__section {
      grid-template-columns: 1fr;
      gap: 16px;
    }
  }
</style>
