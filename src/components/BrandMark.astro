---
import { brand } from '../data/site';

interface Props {
  compact?: boolean;
}

const { compact = false } = Astro.props;
const base = import.meta.env.BASE_URL;
---

<span
  class:list={['brand-lockup', { 'brand-lockup--compact': compact }]}
  aria-label={`${brand.name} — ${brand.person}`}
>
  <img
    class="brand-lockup__mark"
    src={`${base}branding/nepomka-favicon.png`}
    width="64"
    height="64"
    alt=""
    aria-hidden="true"
  />
  <span class="brand-lockup__text">
    <strong>{brand.name}</strong>
    <small>{brand.person}</small>
  </span>
</span>

<style>
  .brand-lockup {
    gap: 10px;
  }

  .brand-lockup__mark {
    display: block;
    object-fit: contain;
  }

  .brand-lockup__text strong {
    letter-spacing: 0.025em;
    text-transform: none;
  }

  .brand-lockup__text small {
    max-width: 220px;
    letter-spacing: 0.055em;
    white-space: nowrap;
  }

  @media (max-width: 760px) {
    .brand-lockup__text small {
      display: none;
    }
  }
</style>
