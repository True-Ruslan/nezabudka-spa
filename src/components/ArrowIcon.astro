---
type Direction = 'up-right' | 'right' | 'left';

interface Props {
  direction: Direction;
  class?: string;
}

const { direction, class: className } = Astro.props;
---

<svg
  class:list={['arrow-icon', `arrow-icon--${direction}`, className]}
  data-arrow-icon={direction}
  width="16"
  height="16"
  viewBox="0 0 16 16"
  fill="none"
  xmlns="http://www.w3.org/2000/svg"
  aria-hidden="true"
  focusable="false"
>
  {
    direction === 'up-right' ? (
      <path
        d="M5 11L11 5M6 5H11V10"
        stroke="currentColor"
        stroke-width="1.6"
        stroke-linecap="round"
        stroke-linejoin="round"
      />
    ) : direction === 'right' ? (
      <path
        d="M3 8H13M9.5 4.5L13 8L9.5 11.5"
        stroke="currentColor"
        stroke-width="1.6"
        stroke-linecap="round"
        stroke-linejoin="round"
      />
    ) : (
      <path
        d="M13 8H3M6.5 4.5L3 8L6.5 11.5"
        stroke="currentColor"
        stroke-width="1.6"
        stroke-linecap="round"
        stroke-linejoin="round"
      />
    )
  }
</svg>

<style is:global>
  .arrow-icon {
    width: 15px;
    height: 15px;
    flex: 0 0 auto;
    overflow: visible;
    opacity: 0.92;
    transition: transform 160ms var(--ease), opacity 160ms var(--ease);
  }

  .button:has(> .arrow-icon) {
    gap: 12px;
  }

  .text-link:has(> .arrow-icon) {
    justify-content: flex-start;
    gap: 10px;
  }

  .contact-social:has(> .arrow-icon) {
    display: inline-flex;
    align-items: center;
    gap: 9px;
  }

  @media (hover: hover) {
    .button:hover > .arrow-icon--up-right,
    .text-link:hover > .arrow-icon--up-right,
    .contact-social:hover > .arrow-icon--up-right,
    .mobile-contact:hover > .arrow-icon--up-right {
      opacity: 1;
      transform: translate(2px, -2px);
    }

    .text-link:hover > .arrow-icon--right,
    .case-row__link:hover .arrow-icon--right {
      opacity: 1;
      transform: translateX(3px);
    }

    .service-back:hover > .arrow-icon--left,
    .case-page__back:hover > .arrow-icon--left {
      opacity: 1;
      transform: translateX(-3px);
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .arrow-icon {
      transition: none;
    }

    .button:hover > .arrow-icon,
    .text-link:hover > .arrow-icon,
    .contact-social:hover > .arrow-icon,
    .mobile-contact:hover > .arrow-icon,
    .case-row__link:hover .arrow-icon,
    .service-back:hover > .arrow-icon,
    .case-page__back:hover > .arrow-icon {
      transform: none;
    }
  }
</style>
