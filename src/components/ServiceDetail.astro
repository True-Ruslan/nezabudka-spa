---
import ArrowIcon from './ArrowIcon.astro';
import type { ServicePageConfig } from '../data/service-pages';
import { offers } from '../data/site';

type Offer = (typeof offers)[number];

interface Props {
  offer: Offer;
  config: ServicePageConfig;
}

const { offer, config } = Astro.props;
const base = import.meta.env.BASE_URL;
---

<article class="service-detail">
  <section class="service-hero">
    <div class="shell">
      <a class="service-back" href={`${base}#expertise`}><ArrowIcon direction="left" /> <span>Все услуги</span></a>
      <div class="service-hero__grid">
        <div class="service-hero__copy">
          <p class="eyeline">{offer.mode} · {offer.price}</p>
          <h1>{offer.title}</h1>
          <p class="service-lead">{config.lead}</p>
          <a class="button" href="#contact">Обсудить услугу <ArrowIcon direction="up-right" /></a>
        </div>
        <aside class="service-summary" aria-label="Условия услуги">
          <span>СТАРТОВАЯ СТОИМОСТЬ</span>
          <strong>{offer.price}</strong>
          <p>{offer.prepare}</p>
        </aside>
      </div>
    </div>
  </section>

  <section class="service-section section--soft" aria-labelledby="service-included-title">
    <div class="shell service-columns">
      <div>
        <p class="section-heading__label">01 / СОСТАВ</p>
        <h2 id="service-included-title">Что входит</h2>
      </div>
      <ul class="service-list">
        {config.included.map((item) => <li>{item}</li>)}
      </ul>
    </div>
  </section>

  <section class="service-section" aria-labelledby="service-workflow-title">
    <div class="shell service-columns">
      <div>
        <p class="section-heading__label">02 / ПРОЦЕСС</p>
        <h2 id="service-workflow-title">Как проходит работа</h2>
      </div>
      <ol class="service-steps">
        {config.workflow.map((item, index) => (
          <li>
            <span>{String(index + 1).padStart(2, '0')}</span>
            <p>{item}</p>
          </li>
        ))}
      </ol>
    </div>
  </section>

  <section class="service-section section--ink" aria-labelledby="service-limitations-title">
    <div class="shell service-columns">
      <div>
        <p class="section-heading__label">03 / УСЛОВИЯ</p>
        <h2 id="service-limitations-title">Что важно учесть</h2>
      </div>
      <ul class="service-list service-list--dark">
        {config.limitations.map((item) => <li>{item}</li>)}
      </ul>
    </div>
  </section>

  <section class="service-section service-faq" aria-labelledby="service-faq-title">
    <div class="shell service-columns">
      <div>
        <p class="section-heading__label">04 / ВОПРОСЫ</p>
        <h2 id="service-faq-title">Перед обращением</h2>
      </div>
      <div class="service-faq__items">
        {config.faq.map((item) => (
          <details>
            <summary>{item.question}</summary>
            <p>{item.answer}</p>
          </details>
        ))}
      </div>
    </div>
  </section>
</article>

<style>
  .service-detail {
    background: var(--paper);
  }

  .service-hero {
    padding: clamp(36px, 5vw, 70px) 0 clamp(82px, 10vw, 150px);
    border-bottom: 1px solid var(--line);
  }

  .service-back {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    margin-bottom: clamp(54px, 7vw, 92px);
    color: var(--steel);
    font-family: var(--font-mono);
    font-size: 10px;
    letter-spacing: 0.12em;
    text-transform: uppercase;
  }

  .service-back:hover {
    color: var(--blue);
  }

  .service-hero__grid {
    display: grid;
    grid-template-columns: minmax(0, 1.35fr) minmax(280px, 0.55fr);
    gap: clamp(48px, 9vw, 150px);
    align-items: end;
  }

  .service-hero__copy h1 {
    max-width: 920px;
    margin-bottom: 28px;
    font-size: clamp(48px, 7vw, 104px);
    font-weight: 500;
    letter-spacing: -0.055em;
    line-height: 0.94;
  }

  .service-lead {
    max-width: 760px;
    margin-bottom: 34px;
    color: var(--steel);
    font-size: clamp(18px, 1.6vw, 22px);
    line-height: 1.55;
  }

  .service-summary {
    padding-top: 24px;
    border-top: 1px solid var(--line);
  }

  .service-summary span {
    display: block;
    margin-bottom: 12px;
    color: var(--steel);
    font-family: var(--font-mono);
    font-size: 10px;
    letter-spacing: 0.14em;
  }

  .service-summary strong {
    display: block;
    margin-bottom: 20px;
    color: var(--blue);
    font-size: clamp(32px, 3vw, 48px);
    font-weight: 600;
    letter-spacing: -0.04em;
  }

  .service-summary p {
    margin-bottom: 0;
    color: var(--steel);
  }

  .service-section {
    padding-block: clamp(82px, 9vw, 138px);
  }

  .service-columns {
    display: grid;
    grid-template-columns: minmax(240px, 0.62fr) minmax(0, 1.38fr);
    gap: clamp(44px, 9vw, 150px);
  }

  .service-columns h2 {
    margin-bottom: 0;
    font-size: clamp(38px, 4.7vw, 68px);
    font-weight: 500;
    letter-spacing: -0.045em;
    line-height: 1;
  }

  .service-list,
  .service-steps {
    margin: 0;
    padding: 0;
    border-top: 1px solid var(--line);
    list-style: none;
  }

  .service-list li {
    padding: 24px 0;
    border-bottom: 1px solid var(--line);
    font-size: clamp(17px, 1.5vw, 20px);
  }

  .service-steps li {
    display: grid;
    padding: 24px 0;
    grid-template-columns: 62px 1fr;
    border-bottom: 1px solid var(--line);
    gap: 22px;
  }

  .service-steps span {
    color: var(--steel);
    font-family: var(--font-mono);
    font-size: 10px;
    letter-spacing: 0.12em;
  }

  .service-steps p {
    margin: 0;
    font-size: clamp(17px, 1.5vw, 20px);
  }

  .section--ink .section-heading__label {
    color: #9aa4aa;
  }

  .section--ink h2 {
    color: var(--white);
  }

  .service-list--dark {
    border-color: var(--line-dark);
  }

  .service-list--dark li {
    border-color: var(--line-dark);
    color: #d7dde0;
  }

  .service-faq__items {
    border-top: 1px solid var(--line);
  }

  .service-faq details {
    border-bottom: 1px solid var(--line);
  }

  .service-faq summary {
    padding: 24px 34px 24px 0;
    cursor: pointer;
    font-size: clamp(18px, 1.6vw, 22px);
    font-weight: 600;
  }

  .service-faq details p {
    max-width: 760px;
    padding: 0 0 26px;
    color: var(--steel);
  }

  @media (max-width: 820px) {
    .service-hero__grid,
    .service-columns {
      grid-template-columns: 1fr;
    }

    .service-hero__grid,
    .service-columns {
      gap: 42px;
    }

    .service-summary {
      max-width: 620px;
    }
  }

  @media (max-width: 540px) {
    .service-hero__copy h1 {
      font-size: clamp(44px, 14vw, 64px);
    }

    .service-steps li {
      grid-template-columns: 44px 1fr;
      gap: 14px;
    }
  }
</style>
