---
import BrandMark from './BrandMark.astro';
import { navigation } from '../data/site';
const base = import.meta.env.BASE_URL;
const href = (hash: string) => `${base}${hash}`;
---

<header class="site-header" data-header>
  <div class="shell site-header__inner">
    <a class="site-header__brand" href={base} aria-label="На главную">
      <BrandMark />
    </a>

    <button
      class="menu-button"
      type="button"
      aria-expanded="false"
      aria-controls="primary-navigation"
      aria-label="Открыть меню"
      data-menu-button
    >
      <span></span><span></span>
    </button>

    <nav class="site-nav" id="primary-navigation" aria-label="Основная навигация" data-menu>
      {navigation.map((item) => <a href={href(item.href)}>{item.label}</a>)}
    </nav>

    <a class="button button--small site-header__cta" href={href('#contact')}>Написать</a>
  </div>
</header>
